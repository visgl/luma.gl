{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@luma.gl/splats": ["../../../modules/splats/src/index.ts"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["."]
}
