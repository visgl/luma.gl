{
  "compilerOptions": {
    "rootDir": ".",

    "types": ["@webgpu/types", "node"],

    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ES2025.Float16"],
    "module": "ES2022",

    "jsx": "react",
    "allowJs": true,
    "checkJs": false,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    // BEGIN TYPE CHECK SETTINGS
    "skipLibCheck": true,

    "strict": true,
    "noImplicitAny": true, // covered by strict
    "noImplicitThis": true, // covered by strict
    "strictBindCallApply": true, // covered by strict
    "strictFunctionTypes": true, // covered by strict
    "useUnknownInCatchVariables": true, // covered by strict
    "strictNullChecks": true, // covered by strict
    "strictPropertyInitialization": true, // covered by strict, requires strict null checks

    // "exactOptionalPropertyTypes": true, // requires strictNullChecks
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    // "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    // END TYPE CHECK SETTINGS

    "paths": {
      "@luma.gl/arrow": ["./modules/arrow/src/index.ts"],
      "@luma.gl/arrow/*": ["./modules/arrow/src/*"],
      "@luma.gl/arrow/test/*": ["./modules/arrow/test/*"],
      "@deck.gl-community/arrow-layers": ["./modules/deck-arrow-layers/src/index.ts"],
      "@deck.gl-community/arrow-layers/*": ["./modules/deck-arrow-layers/src/*"],
      "@deck.gl-community/arrow-layers/test/*": ["./modules/deck-arrow-layers/test/*"],
      "@deck.gl-community/gpu-layers": ["./modules/deck-gpu-layers/src/index.ts"],
      "@deck.gl-community/gpu-layers/*": ["./modules/deck-gpu-layers/src/*"],
      "@deck.gl-community/gpu-layers/test/*": ["./modules/deck-gpu-layers/test/*"],
      "@luma.gl/core": ["./modules/core/src/index.ts"],
      "@luma.gl/core/webgl": ["./modules/core/src/webgl/index.ts"],
      "@luma.gl/core/webgl/*": ["./modules/core/src/webgl/*"],
      "@luma.gl/core/webgpu": ["./modules/core/src/webgpu/index.ts"],
      "@luma.gl/core/webgpu/*": ["./modules/core/src/webgpu/*"],
      "@luma.gl/core/webgl-constants": ["./modules/core/src/webgl-constants/index.ts"],
      "@luma.gl/core/webgl-constants/*": ["./modules/core/src/webgl-constants/*"],
      "@luma.gl/core/wgsl": ["./modules/core/src/wgsl.ts"],
      "@luma.gl/core/wgsl-binding-scan": ["./modules/core/src/wgsl-binding-scan.ts"],
      "@luma.gl/core/*": ["./modules/core/src/*"],
      "@luma.gl/core/test/*": ["./modules/core/test/*"],
      "@luma.gl/effects": ["./modules/effects/src/index.ts"],
      "@luma.gl/effects/*": ["./modules/effects/src/*"],
      "@luma.gl/effects/test/*": ["./modules/effects/test/*"],
      "@luma.gl/engine/physics": ["./modules/engine/src/graph/physics/index.ts"],
      "@luma.gl/engine/tables": ["./modules/engine/src/graph/tables/index.ts"],
      "@luma.gl/engine/models": ["./modules/engine/src/graph/models/index.ts"],
      "@luma.gl/engine": ["./modules/engine/src/index.ts"],
      "@luma.gl/engine/*": ["./modules/engine/src/*"],
      "@luma.gl/engine/test/*": ["./modules/engine/test/*"],
      "@luma.gl/gltf": ["./modules/gltf/src/index.ts"],
      "@luma.gl/gltf/*": ["./modules/gltf/src/*"],
      "@luma.gl/gltf/test/*": ["./modules/gltf/test/*"],
      "@luma.gl/graph": ["./modules/graph/src/index.ts"],
      "@luma.gl/graph/test/*": ["./modules/graph/test/*"],
      "@luma.gl/graph/*": ["./modules/graph/src/*"],
      "@luma.gl/gpgpu/_internal/*": ["./modules/gpgpu/src/execution/*"],
      "@luma.gl/gpgpu": ["./modules/gpgpu/src/index.ts"],
      "@luma.gl/gpgpu/*": ["./modules/gpgpu/src/*"],
      "@luma.gl/gpgpu/test/*": ["./modules/gpgpu/test/*"],
      "@luma.gl/anari": ["./modules/anari/src/index.ts"],
      "@luma.gl/anari/*": ["./modules/anari/src/*"],
      "@luma.gl/slang": ["./modules/slang/src/index.ts"],
      "@luma.gl/slang/*": ["./modules/slang/src/*"],
      "@luma.gl/shadertools": ["./modules/shadertools/src/index.ts"],
      "@luma.gl/shadertools/*": ["./modules/shadertools/src/*"],
      "@luma.gl/shadertools/test/*": ["./modules/shadertools/test/*"],
      "@luma.gl/splats": ["./modules/splats/src/index.ts"],
      "@luma.gl/splats/*": ["./modules/splats/src/*"],
      "@luma.gl/splats/test/*": ["./modules/splats/test/*"],
      "@luma.gl/text": ["./modules/text/src/index.ts"],
      "@luma.gl/three": ["./modules/three/src/index.ts"],
      "@luma.gl/three/*": ["./modules/three/src/*"],
      "@luma.gl/text/*": ["./modules/text/src/*"],
      "@luma.gl/text/test/*": ["./modules/text/test/*"],
      "@luma.gl/test-utils": ["./modules/test-utils/src/index.ts"],
      "@luma.gl/test-utils/*": ["./modules/test-utils/src/*"],
      "@luma.gl/test-utils/test/*": ["./modules/test-utils/test/*"],
      "dev-modules/*": ["./dev-modules/*"],
      "test/*": ["./test/*"]
    },
    "plugins": [
      {
        "transform": "@vis.gl/ts-plugins/ts-transform-version-inline"
      },
      {
        "transform": "@luma.gl/ts-transform-inline-webgl-constants"
      },
      {
        "transform": "@vis.gl/ts-plugins/ts-transform-remove-glsl-comments"
      },
      {
        "transform": "@vis.gl/ts-plugins/ts-transform-append-extension",
        "extensions": [".js"],
        "after": true
      },
      {
        "transform": "@vis.gl/ts-plugins/ts-transform-append-extension",
        "extensions": [".js"],
        "afterDeclarations": true
      }
    ]
  },
  // Note: an "include": [] section dramatically limits coverage.
  // Better to explicitly exclude things.
  "include": [
    "devtools/**/*",
    "modules/*/src",
    "modules/*/test",
    "examples/**/*",
    "test/**/*",
    "node_modules/@webgpu/types"
  ],
  "exclude":[
    "modules/**/wip",
    "modules/**/dist",
    "node_modules"
  ]
}
