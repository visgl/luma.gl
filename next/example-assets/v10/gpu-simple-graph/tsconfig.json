{
  "compilerOptions": {
    "types": ["@webgpu/types"],
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": false,
    "paths": {
      "@luma.gl/graph/arrow": ["../../../modules/graph/src/arrow/index.ts"],
      "@luma.gl/graph/arrow": ["../../../modules/graph/src/arrow/index.ts"],
      "@luma.gl/engine/arrow": ["../../../modules/engine/src/arrow/index.ts"],
      "@luma.gl/core/webgl-constants": ["../../../modules/core/src/webgl-constants/index.ts"],
      "@luma.gl/core/webgl-constants/*": ["../../../modules/core/src/webgl-constants/*"],
      "@luma.gl/core": ["../../../modules/core/src/index.ts"],
      "@luma.gl/core/*": ["../../../modules/core/src/*"],
      "@luma.gl/engine": ["../../../modules/engine/src/index.ts"],
      "@luma.gl/engine/*": ["../../../modules/engine/src/*"],
      "@luma.gl/graph": ["../../../modules/graph/src/index.ts"],
      "@luma.gl/graph/*": ["../../../modules/graph/src/*"],
      "@luma.gl/graph/gpu-simple-graph": ["../../../modules/graph/src/gpu-simple-graph/index.ts"],
      "@luma.gl/graph/*": ["../../../modules/graph/src/*"],
      "@luma.gl/shaders": ["../../../modules/shaders/src/index.ts"],
      "@luma.gl/shaders/*": ["../../../modules/shaders/src/*"],
      "@luma.gl/core/webgl": ["../../../modules/core/src/webgl/index.ts"],
      "@luma.gl/core/webgl/*": ["../../../modules/core/src/webgl/*"],
      "@luma.gl/core/webgpu": ["../../../modules/core/src/webgpu/index.ts"],
      "@luma.gl/core/webgpu/*": ["../../../modules/core/src/webgpu/*"],
    }
  },
  "include": [".", "../gpgpu/src"]
}
