{
  "name": "luma.gl-monorepo",
  "description": "WebGL2 Components for High Performance Rendering and Computation",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/luma.gl"
  },
  "keywords": [
    "webgl",
    "visualization",
    "animation",
    "3d"
  ],
  "workspaces": [
    "dev-modules/*",
    "modules/*",
    "examples/**/*",
    "website"
  ],
  "browser": {
    "fs": false
  },
  "scripts": {
    "bootstrap": "bash ./scripts/bootstrap.sh",
    "start": "open https://luma.gl/docs/getting-started",
    "build": "ocular-clean && yarn build-webgl-constants && ocular-build && node scripts/build-core-cjs.mjs",
    "bundle-size": "node ./scripts/bundle-size.mjs",
    "lint": "ocular-lint",
    "publish-beta": "ocular-publish version-only-beta",
    "publish-prod": "ocular-publish version-only-prod",
    "test": "yarn test-node && yarn test-headless",
    "test-node": "yarn build-webgl-constants && ocular-test node",
    "test-node-coverage": "yarn build-webgl-constants && LUMA_TEST_NODE_COVERAGE=true ocular-test node --coverage.enabled --coverage.provider=istanbul --coverage.reporter=lcovonly --coverage.reportsDirectory=coverage-node",
    "test-browser": "ocular-test browser",
    "test-browser-benchmarks": "LUMA_TEST_BROWSER_BENCHMARKS=true ocular-test headless --no-coverage",
    "test-presentation": "node scripts/playwright/presentation-canary.mjs",
    "test-headless": "ocular-test headless",
    "test-coverage": "ocular-test headless --coverage",
    "test-geospatial-package": "node ./scripts/verify-gpu-graph-geospatial-package.mjs",
    "test-gpu-raster-package": "node ./scripts/verify-gpu-graph-raster-package.mjs",
    "examples:typecheck": "node ./scripts/examples-typecheck.mjs",
    "examples:synchronize-mobile-support": "node ./scripts/examples/synchronize-mobile-support-metadata.mjs",
    "examples:test-mobile": "node ./scripts/playwright/mobile-example-smoke.mjs",
    "test-fast": "yarn lint && yarn test-node",
    "test-website": "yarn website:build",
    "website:build": "yarn workspace website-docusaurus build",
    "website:start": "yarn workspace website-docusaurus start",
    "website-debug": "node ./scripts/playwright/website-playwright.mjs",
    "gltf:reference-evidence": "node ./scripts/gltf-reference/capture-reference-evidence.mjs",
    "gltf:reference-evidence:test": "node --test ./scripts/gltf-reference/*.test.mjs ./scripts/playwright/*.test.mjs",
    "playwright:install": "playwright install chromium webkit",
    "metrics": "./scripts/metrics.sh && ocular-metrics",
    "build-webgl-constants": "esbuild modules/core/src/webgl-constants/index.ts --bundle --format=cjs --outfile=modules/core/dist/webgl-constants/index.cjs",
    "test-package-layering": "node scripts/verify-package-layering.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@loaders.gl/core": "~5.0.0-beta.1",
    "@loaders.gl/pointclouds": "~5.0.0-beta.1",
    "@loaders.gl/scene": "~5.0.0-beta.1",
    "@loaders.gl/sql": "~5.0.0-beta.1",
    "@loaders.gl/tables": "~5.0.0-beta.1",
    "@loaders.gl/textures": "~5.0.0-beta.1",
    "@luma.gl/ts-transform-inline-webgl-constants": "workspace:*",
    "@math.gl/dggs": "~5.0.0-beta.1",
    "@math.gl/geospatial": "~5.0.0-beta.1",
    "@probe.gl/test-utils": "^4.1.1",
    "@types/node": "22.15.2",
    "@vis.gl/dev-tools": "^2.0.0-beta.1",
    "@vis.gl/ts-plugins": "^2.0.0-beta.1",
    "@vitest/browser-playwright": "5.0.2",
    "@vitest/coverage-istanbul": "5.0.2",
    "a5-js": "^0.8.0",
    "apache-arrow": "^17.0.0",
    "esbuild": "^0.28.1",
    "h3-js": "^4.4.0",
    "playwright": "^1.58.0",
    "pngjs": "^7.0.0",
    "pre-commit": "^1.2.2",
    "probe.gl": "^5.0.0",
    "texture-compressor": "^1.0.2",
    "vite": "^8.0.0",
    "vitest": "5.0.2",
    "wgsl_reflect": "1.2.3",
    "yaml": "^2.8.1"
  },
  "resolutions": {
    "@cmfcmf/docusaurus-search-local": "^2.0.1",
    "@docusaurus/plugin-client-redirects": "^3.10.2",
    "@docusaurus/plugin-content-docs": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "cheerio": "1.0.0-rc.9",
    "@luma.gl/core": "workspace:*",
    "@luma.gl/engine": "workspace:*",
    "@luma.gl/shadertools": "workspace:*",
    "@deck.gl/core@npm:9.4.0": "patch:@deck.gl/core@npm%3A9.4.0#~/.yarn/patches/@deck.gl-core-npm-9.4.0-707f3fb147.patch",
    "@vitest/browser": "5.0.2",
    "@vitest/browser-playwright": "5.0.2",
    "@luma.gl/webgl": "workspace:modules/core",
    "@loaders.gl/core/apache-arrow": "^17.0.0",
    "@loaders.gl/tables/apache-arrow": "^17.0.0",
    "@deck.gl/core/@math.gl/core": "5.0.0-beta.1"
  },
  "pre-commit": [
    "test-fast"
  ],
  "dependencies": {
    "@deck.gl-community/panels": "https://github.com/visgl/deck.gl-community.git#workspace=@deck.gl-community/panels&commit=ede78777382aaf1c821a9c427cdb48eb4e77e20e",
    "@math.gl/core": "~5.0.0-beta.1",
    "@types/offscreencanvas": "^2019.7.3",
    "preact": "^10.17.0"
  },
  "packageManager": "yarn@4.13.0+sha512.5c20ba010c99815433e5c8453112165e673f1c7948d8d2b267f4b5e52097538658388ebc9f9580656d9b75c5cc996f990f611f99304a2197d4c56d21eea370e7"
}
