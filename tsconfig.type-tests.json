{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@luma.gl/core": [
        "./modules/core/src/index.ts"
      ],
      "@luma.gl/core/*": [
        "./modules/core/src/*"
      ],
      "@luma.gl/shadertools": [
        "./modules/shadertools/src/index.ts"
      ],
      "@luma.gl/shadertools/*": [
        "./modules/shadertools/src/*"
      ],
      "@luma.gl/engine": [
        "./modules/engine/src/index.ts"
      ],
      "@luma.gl/engine/*": [
        "./modules/engine/src/*"
      ],
      "@luma.gl/gpgpu": [
        "./modules/gpgpu/src/index.ts"
      ],
      "@luma.gl/gpgpu/*": [
        "./modules/gpgpu/src/*"
      ],
      "@luma.gl/experimental": [
        "./modules/experimental/src/index.ts"
      ],
      "@luma.gl/experimental/*": [
        "./modules/experimental/src/*"
      ],
      "@luma.gl/core/webgl": [
        "./modules/core/src/webgl/index.ts"
      ],
      "@luma.gl/core/webgl/*": [
        "./modules/core/src/webgl/*"
      ],
      "@luma.gl/core/webgpu": [
        "./modules/core/src/webgpu/index.ts"
      ],
      "@luma.gl/core/webgpu/*": [
        "./modules/core/src/webgpu/*"
      ],
      "@luma.gl/core/webgl-constants": [
        "./modules/core/src/webgl-constants/index.ts"
      ],
      "@luma.gl/core/webgl-constants/*": [
        "./modules/core/src/webgl-constants/*"
      ],
      "@luma.gl/core/wgsl": [
        "./modules/core/src/wgsl.ts"
      ],
      "@luma.gl/core/wgsl-binding-scan": [
        "./modules/core/src/wgsl-binding-scan.ts"
      ],
      "@luma.gl/graph": [
        "./modules/graph/src/index.ts"
      ],
      "@luma.gl/graph/*": [
        "./modules/graph/src/*"
      ]
    }
  },
  "include": [
    "./modules/shadertools/test/lib/uniform-types.spec.ts",
    "./modules/engine/test/shader-inputs-types.spec.ts",
    "./modules/gpgpu/test/gpu-data/gpu-data-types.node.spec.ts",
    "./modules/graph/test/geospatial/geospatial-types.spec.ts"
  ],
  "exclude": [
    "./modules/**/dist",
    "node_modules"
  ]
}
