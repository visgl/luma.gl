{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@luma.gl/core": [
        "./modules/core/src/index.ts"
      ],
      "@luma.gl/core/*": [
        "./modules/core/src/*"
      ],
      "@luma.gl/constants": [
        "./modules/constants/src/index.ts"
      ],
      "@luma.gl/constants/*": [
        "./modules/constants/src/*"
      ],
      "@luma.gl/shadertools": [
        "./modules/shadertools/src/index.ts"
      ],
      "@luma.gl/shadertools/*": [
        "./modules/shadertools/src/*"
      ],
      "@luma.gl/engine": [
        "./modules/engine/src/index.ts"
      ],
      "@luma.gl/engine/*": [
        "./modules/engine/src/*"
      ],
      "@luma.gl/gpgpu": [
        "./modules/gpgpu/src/index.ts"
      ],
      "@luma.gl/gpgpu/*": [
        "./modules/gpgpu/src/*"
      ],
      "@luma.gl/experimental": [
        "./modules/experimental/src/index.ts"
      ],
      "@luma.gl/experimental/*": [
        "./modules/experimental/src/*"
      ]
    }
  },
  "include": [
    "./modules/shadertools/test/lib/uniform-types.spec.ts",
    "./modules/engine/test/shader-inputs-types.spec.ts",
    "./modules/gpgpu/test/gpu-data/gpu-data-types.node.spec.ts",
    "./modules/experimental/test/geospatial/geospatial-types.spec.ts"
  ],
  "exclude": [
    "./modules/**/dist",
    "node_modules"
  ]
}
