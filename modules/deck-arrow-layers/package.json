{
  "name": "@deck.gl-community/arrow-layers",
  "version": "10.0.0-rc.1",
  "private": true,
  "description": "deck.gl layers backed by Apache Arrow and luma.gl GPU vectors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/luma.gl"
  },
  "type": "module",
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@deck.gl-community/gpu-layers": "10.0.0-rc.1",
    "@deck.gl/core": "10.0.0-alpha.2",
    "@luma.gl/core": "10.0.0-rc.1",
    "@luma.gl/engine": "10.0.0-rc.1",
    "@luma.gl/graph": "10.0.0-rc.1",
    "@luma.gl/shaders": "10.0.0-rc.1",
    "apache-arrow": "^17.0.0"
  }
}
