{
  "name": "@luma.gl/splats",
  "version": "10.0.0-alpha.2",
  "private": true,
  "description": "Gaussian splat rendering utilities for luma.gl",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/luma.gl"
  },
  "keywords": [
    "webgl",
    "webgpu",
    "visualization",
    "3d",
    "gaussian-splats"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@luma.gl/core": "10.0.0-alpha.2",
    "@luma.gl/engine": "10.0.0-alpha.2",
    "@luma.gl/experimental": "10.0.0-alpha.2",
    "@luma.gl/gpgpu": "10.0.0-alpha.2",
    "@luma.gl/shadertools": "10.0.0-alpha.2"
  }
}
