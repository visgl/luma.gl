{
  "name": "@luma.gl/splats",
  "version": "9.4.0-beta.1",
  "description": "Gaussian splat rendering utilities for luma.gl",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/luma.gl"
  },
  "keywords": [
    "webgl",
    "webgpu",
    "visualization",
    "3d",
    "gaussian-splats"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@luma.gl/core": "9.4.0-beta.1",
    "@luma.gl/engine": "9.4.0-beta.1",
    "@luma.gl/experimental": "9.4.0-beta.1",
    "@luma.gl/gpgpu": "9.4.0-beta.1",
    "@luma.gl/shadertools": "9.4.0-beta.1"
  }
}
