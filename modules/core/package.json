{
  "name": "@luma.gl/core",
  "version": "10.0.0-alpha.4",
  "description": "The luma.gl core Device API",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/luma.gl"
  },
  "keywords": [
    "webgl",
    "visualization",
    "animation",
    "3d"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./webgl": {
      "types": "./dist/webgl/index.d.ts",
      "import": "./dist/webgl/index.js",
      "require": "./dist/webgl/index.cjs"
    },
    "./webgpu": {
      "types": "./dist/webgpu/index.d.ts",
      "import": "./dist/webgpu/index.js",
      "require": "./dist/webgpu/index.cjs"
    },
    "./webgl-constants": {
      "types": "./dist/webgl-constants/index.d.ts",
      "import": "./dist/webgl-constants/index.js",
      "require": "./dist/webgl-constants/index.cjs"
    },
    "./wgsl": {
      "types": "./dist/wgsl.d.ts",
      "import": "./dist/wgsl.js",
      "require": "./dist/wgsl.cjs"
    },
    "./wgsl-binding-scan": {
      "types": "./dist/wgsl-binding-scan.d.ts",
      "import": "./dist/wgsl-binding-scan.js",
      "require": "./dist/wgsl-binding-scan.cjs"
    },
    "./webgl/debug": {
      "types": "./dist/webgl/debug.d.ts",
      "import": "./dist/webgl/debug.js",
      "require": "./dist/webgl/debug.cjs"
    }
  },
  "files": [
    "src",
    "dist",
    "dist.min.js",
    "README.md"
  ],
  "sideEffects": [
    "./src/webgl/debug.ts",
    "./src/webgl/context/debug/webgl-developer-tools.ts",
    "./src/webgl/context/debug/spector.ts",
    "./dist/webgl/debug.js",
    "./dist/webgl/context/debug/webgl-developer-tools.js",
    "./dist/webgl/context/debug/spector.js",
    "./dist/webgl/debug.cjs",
    "./dist/webgl/context/debug/webgl-developer-tools.cjs",
    "./dist/webgl/context/debug/spector.cjs"
  ],
  "scripts": {
    "build-minified-bundle": "ocular-bundle ./bundle.ts --output=dist/dist.min.js",
    "build-dev-bundle": "ocular-bundle ./bundle.ts --output=dist/dist.dev.js --env=dev",
    "prepublishOnly": "npm run build-minified-bundle && npm run build-dev-bundle"
  },
  "dependencies": {
    "@math.gl/types": "~5.0.0-alpha.15",
    "@probe.gl/env": "^4.1.1",
    "@probe.gl/log": "^4.1.1",
    "@probe.gl/stats": "^4.1.1",
    "@types/offscreencanvas": "^2019.7.3",
    "@webgpu/types": "^0.1.69"
  },
  "gitHead": "c636c34b8f1581eed163e94543a8eb1f4382ba8e"
}
