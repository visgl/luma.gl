{
  "name": "@luma.gl/experimental",
  "description": "luma.gl experimental features",
  "version": "9.4.0-beta.3",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/luma.gl"
  },
  "keywords": [
    "webgl",
    "visualization",
    "animation",
    "3d"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./geospatial": {
      "types": "./dist/geospatial/index.d.ts",
      "import": "./dist/geospatial/index.js",
      "require": "./dist/geospatial/index.cjs"
    },
    "./gpu-tables": {
      "types": "./dist/gpu-tables/index.d.ts",
      "import": "./dist/gpu-tables/index.js",
      "require": "./dist/gpu-tables/index.cjs"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js",
      "require": "./dist/models/index.cjs"
    },
    "./gpu-raster": {
      "types": "./dist/gpu-raster/index.d.ts",
      "import": "./dist/gpu-raster/index.js",
      "require": "./dist/gpu-raster/index.cjs"
    },
    "./lucim": {
      "types": "./dist/lucim/index.d.ts",
      "import": "./dist/lucim/index.js",
      "require": "./dist/lucim/index.cjs"
    },
    "./gpu-project": {
      "types": "./dist/gpu-project/index.d.ts",
      "import": "./dist/gpu-project/index.js",
      "require": "./dist/gpu-project/index.cjs"
    },
    "./gpu-project/benchmarks": {
      "types": "./dist/gpu-project/benchmarks.d.ts",
      "import": "./dist/gpu-project/benchmarks.js",
      "require": "./dist/gpu-project/benchmarks.cjs"
    },
    "./gpu-dataframe": {
      "types": "./dist/gpu-dataframe/index.d.ts",
      "import": "./dist/gpu-dataframe/index.js",
      "require": "./dist/gpu-dataframe/index.cjs"
    },
    "./gpu-sql": {
      "types": "./dist/gpu-sql/index.d.ts",
      "import": "./dist/gpu-sql/index.js",
      "require": "./dist/gpu-sql/index.cjs"
    },
    "./gpu-crossfilter": {
      "types": "./dist/gpu-crossfilter/index.d.ts",
      "import": "./dist/gpu-crossfilter/index.js",
      "require": "./dist/gpu-crossfilter/index.cjs"
    },
    "./gpu-trace": {
      "types": "./dist/gpu-trace/index.d.ts",
      "import": "./dist/gpu-trace/index.js",
      "require": "./dist/gpu-trace/index.cjs"
    }
  },
  "files": [
    "src",
    "dist",
    "dist.min.js",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build-minified-bundle": "ocular-bundle ./bundle.ts --output=dist/dist.min.js",
    "build-dev-bundle": "ocular-bundle ./bundle.ts --output=dist/dist.dev.js --env=dev",
    "prepublishOnly": "npm run build-minified-bundle && npm run build-dev-bundle"
  },
  "peerDependencies": {
    "@luma.gl/core": "~9.4.0-alpha.1",
    "@luma.gl/engine": "~9.4.0-alpha.1",
    "@luma.gl/shadertools": "~9.4.0-alpha.1"
  },
  "dependencies": {
    "@luma.gl/gpgpu": "9.4.0-beta.3",
    "@math.gl/core": "^4.1.0",
    "@math.gl/types": "^4.1.0"
  },
  "gitHead": "c636c34b8f1581eed163e94543a8eb1f4382ba8e"
}
