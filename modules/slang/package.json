{
  "name": "@luma.gl/slang",
  "version": "10.0.0-alpha.2",
  "description": "Experimental TypeScript Slang to GLSL and WGSL transpiler for luma.gl",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/luma.gl"
  },
  "keywords": [
    "slang",
    "glsl",
    "wgsl",
    "shader",
    "transpiler"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./luma": {
      "types": "./dist/luma.d.ts",
      "import": "./dist/luma.js",
      "require": "./dist/luma.cjs"
    }
  },
  "files": [
    "src",
    "dist",
    "dist.min.js",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build-minified-bundle": "ocular-bundle ./src/index.ts --output=dist/dist.min.js",
    "build-dev-bundle": "ocular-bundle ./src/index.ts --output=dist/dist.dev.js --env=dev",
    "prepublishOnly": "npm run build-minified-bundle && npm run build-dev-bundle"
  },
  "publishConfig": {
    "access": "public"
  }
}
