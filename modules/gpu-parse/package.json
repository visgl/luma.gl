{
  "name": "@luma.gl/gpu-parse",
  "version": "9.4.0-alpha.4",
  "private": true,
  "description": "Experimental GPU-native decoders for columnar data formats",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/luma.gl"
  },
  "keywords": [
    "webgpu",
    "parquet",
    "columnar",
    "decoding"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
