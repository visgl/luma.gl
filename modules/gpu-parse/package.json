      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@luma.gl/core": "9.4.0-alpha.4",
    "@luma.gl/engine": "9.4.0-alpha.4",
    "@luma.gl/gpgpu": "9.4.0-alpha.4"
  }
}
