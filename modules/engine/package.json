{
  "name": "@luma.gl/engine",
  "version": "10.0.0-alpha.4",
  "description": "3D Engine Components for luma.gl",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/luma.gl"
  },
  "keywords": [
    "webgl",
    "visualization",
    "animation",
    "3d"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./experimental/controls": {
      "types": "./dist/experimental/controls/index.d.ts",
      "import": "./dist/experimental/controls/index.js",
      "require": "./dist/experimental/controls/index.cjs"
    },
    "./experimental/materials": {
      "types": "./dist/experimental/materials/index.d.ts",
      "import": "./dist/experimental/materials/index.js",
      "require": "./dist/experimental/materials/index.cjs"
    },
    "./experimental/textures": {
      "types": "./dist/experimental/textures/index.d.ts",
      "import": "./dist/experimental/textures/index.js",
      "require": "./dist/experimental/textures/index.cjs"
    },
    "./experimental/webxr": {
      "types": "./dist/experimental/webxr/index.d.ts",
      "import": "./dist/experimental/webxr/index.js",
      "require": "./dist/experimental/webxr/index.cjs"
    }
  },
  "files": [
    "src",
    "dist",
    "dist.min.js",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build-minified-bundle": "ocular-bundle ./bundle.ts --output=dist/dist.min.js",
    "build-dev-bundle": "ocular-bundle ./bundle.ts --output=dist/dist.dev.js --env=dev",
    "prepublishOnly": "npm run build-minified-bundle && npm run build-dev-bundle"
  },
  "peerDependencies": {
    "@luma.gl/core": "~10.0.0-alpha.3",
    "@luma.gl/shadertools": "~10.0.0-alpha.3"
  },
  "dependencies": {
    "@math.gl/core": "~5.0.0-alpha.19",
    "@math.gl/geometry": "~5.0.0-alpha.19",
    "probe.gl": "^5.0.0"
  },
  "gitHead": "c636c34b8f1581eed163e94543a8eb1f4382ba8e",
  "devDependencies": {
    "@luma.gl/anari": "10.0.0-alpha.4"
  }
}
