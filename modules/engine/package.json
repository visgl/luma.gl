{
  "name": "@luma.gl/engine",
  "version": "10.0.0-alpha.6",
  "description": "3D Engine Components for luma.gl",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/luma.gl"
  },
  "keywords": [
    "webgl",
    "visualization",
    "animation",
    "3d"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./experimental/controls": {
      "types": "./dist/experimental/controls/index.d.ts",
      "import": "./dist/experimental/controls/index.js",
      "require": "./dist/experimental/controls/index.cjs"
    },
    "./experimental/materials": {
      "types": "./dist/experimental/materials/index.d.ts",
      "import": "./dist/experimental/materials/index.js",
      "require": "./dist/experimental/materials/index.cjs"
    },
    "./experimental/textures": {
      "types": "./dist/experimental/textures/index.d.ts",
      "import": "./dist/experimental/textures/index.js",
      "require": "./dist/experimental/textures/index.cjs"
    },
    "./experimental/webxr": {
      "types": "./dist/experimental/webxr/index.d.ts",
      "import": "./dist/experimental/webxr/index.js",
      "require": "./dist/experimental/webxr/index.cjs"
    },
    "./physics": {
      "types": "./dist/graph/physics/index.d.ts",
      "import": "./dist/graph/physics/index.js",
      "require": "./dist/graph/physics/index.cjs"
    },
    "./tables": {
      "types": "./dist/graph/tables/index.d.ts",
      "import": "./dist/graph/tables/index.js",
      "require": "./dist/graph/tables/index.cjs"
    },
    "./models": {
      "types": "./dist/graph/models/index.d.ts",
      "import": "./dist/graph/models/index.js",
      "require": "./dist/graph/models/index.cjs"
    },
    "./gltf": {
      "types": "./dist/gltf/index.d.ts",
      "import": "./dist/gltf/index.js",
      "require": "./dist/gltf/index.cjs"
    },
    "./gltf-physics": {
      "types": "./dist/gltf/physics/index.d.ts",
      "import": "./dist/gltf/physics/index.js",
      "require": "./dist/gltf/physics/index.cjs"
    },
    "./splats": {
      "types": "./dist/splats/index.d.ts",
      "import": "./dist/splats/index.js",
      "require": "./dist/splats/index.cjs"
    },
    "./text": {
      "types": "./dist/text/index.d.ts",
      "import": "./dist/text/index.js",
      "require": "./dist/text/index.cjs"
    },
    "./text-fonts": {
      "types": "./dist/text/fonts/index.d.ts",
      "import": "./dist/text/fonts/index.js",
      "require": "./dist/text/fonts/index.cjs"
    },
    "./text-3d": {
      "types": "./dist/text/text-3d/index.d.ts",
      "import": "./dist/text/text-3d/index.js",
      "require": "./dist/text/text-3d/index.cjs"
    },
    "./text-experimental": {
      "types": "./dist/text/experimental.d.ts",
      "import": "./dist/text/experimental.js",
      "require": "./dist/text/experimental.cjs"
    },
    "./effects": {
      "types": "./dist/effects/index.d.ts",
      "import": "./dist/effects/index.js",
      "require": "./dist/effects/index.cjs"
    },
    "./arrow": {
      "types": "./dist/arrow/index.d.ts",
      "import": "./dist/arrow/index.js",
      "require": "./dist/arrow/index.cjs"
    }
  },
  "files": [
    "src",
    "dist",
    "dist.min.js",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "licenses"
  ],
  "sideEffects": false,
  "scripts": {
    "build-minified-bundle": "ocular-bundle ./bundle.ts --output=dist/dist.min.js",
    "build-dev-bundle": "ocular-bundle ./bundle.ts --output=dist/dist.dev.js --env=dev",
    "prepublishOnly": "npm run build-minified-bundle && npm run build-dev-bundle"
  },
  "peerDependencies": {
    "@luma.gl/core": "~10.0.0-alpha.3",
    "@luma.gl/shaders": "~10.0.0-alpha.3",
    "apache-arrow": ">=17.0.0"
  },
  "dependencies": {
    "@luma.gl/gpgpu": "10.0.0-alpha.6",
    "@luma.gl/graph": "10.0.0-alpha.6",
    "@mapbox/tiny-sdf": "^2.0.7",
    "@math.gl/core": "~5.0.0-beta.2",
    "@math.gl/geometry": "~5.0.0-beta.2",
    "probe.gl": "^5.0.0"
  },
  "gitHead": "c636c34b8f1581eed163e94543a8eb1f4382ba8e",
  "devDependencies": {
    "@luma.gl/anari": "10.0.0-alpha.6"
  },
  "peerDependenciesMeta": {
    "apache-arrow": {
      "optional": true
    }
  }
}
