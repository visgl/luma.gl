{
  "name": "@deck.gl-community/gpu-layers",
  "version": "9.4.0-beta.1",
  "private": true,
  "description": "deck.gl layers using the WebGPU-only GPU compute graph",
  "license": "MIT",
  "type": "module",
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./query": {
      "types": "./dist/query/index.d.ts",
      "import": "./dist/query/index.js",
      "require": "./dist/query/index.cjs"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@deck.gl/core": "9.3.4",
    "@luma.gl/core": "9.4.0-beta.1",
    "@luma.gl/engine": "9.4.0-beta.1",
    "@luma.gl/experimental": "9.4.0-beta.1",
    "@luma.gl/shadertools": "9.4.0-beta.1"
  }
}
