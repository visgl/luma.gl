{
  "compilerOptions": {
    "types": ["@webgpu/types"],
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@luma.gl/graph/arrow": ["../../../modules/graph/src/arrow/index.ts"],
      "@luma.gl/graph/arrow": ["../../../modules/graph/src/arrow/index.ts"],
      "@luma.gl/engine/arrow": ["../../../modules/engine/src/arrow/index.ts"],
      "@luma.gl/core": ["../../../modules/core/src/index.ts"],
      "@luma.gl/core/*": ["../../../modules/core/src/*"],
      "@luma.gl/engine": ["../../../modules/engine/src/index.ts"],
      "@luma.gl/engine/*": ["../../../modules/engine/src/*"],
      "@luma.gl/graph/gpu-simple-graph": ["../../../modules/graph/src/gpu-simple-graph/index.ts"],
      "@luma.gl/graph/*": ["../../../modules/graph/src/*"],
      "@luma.gl/shaders": ["../../../modules/shaders/src/index.ts"],
      "@luma.gl/shaders/*": ["../../../modules/shaders/src/*"],
      "@luma.gl/engine/text": ["../../../modules/engine/src/text/index.ts"],
      "@luma.gl/engine/text-experimental": ["../../../modules/engine/src/text/experimental.ts"],
      "@luma.gl/core/webgpu": ["../../../modules/core/src/webgpu/index.ts"],
      "@luma.gl/core/webgpu/*": ["../../../modules/core/src/webgpu/*"]
    }
  },
  "include": ["."]
}
