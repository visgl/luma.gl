{
  "name": "luma.gl-examples-deck-fireflies",
  "version": "10.0.0-beta.4",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "build:website": "vite build --mode website --outDir ../../../website/.generated/example-assets/standalone-examples/fireflies --emptyOutDir",
    "test:visual": "node ../riverfront-lighting-visual.mjs fireflies",
    "generate:thumbnail": "node ../riverfront-lighting-visual.mjs fireflies --thumbnail"
  },
  "dependencies": {
    "@deck.gl-community/gpu-layers": "10.0.0-beta.4",
    "@deck.gl/core": "10.0.0-alpha.2",
    "@luma.gl/core": "10.0.0-beta.4",
    "@luma.gl/engine": "10.0.0-beta.4",
    "@luma.gl/shaders": "10.0.0-beta.4",
    "@math.gl/core": "^5.0.3",
    "@math.gl/earth": "^5.0.3"
  },
  "devDependencies": {
    "playwright": "^1.58.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0"
  }
}
