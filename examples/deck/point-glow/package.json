{
  "name": "luma.gl-examples-deck-point-glow",
  "version": "10.0.0-alpha.7",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "build:website": "vite build --mode website --outDir ../../../website/.generated/example-assets/standalone-examples/point-glow --emptyOutDir",
    "test:visual": "node ../riverfront-lighting-visual.mjs fireflies --example=point-glow && node ../riverfront-lighting-visual.mjs fireflies --example=point-glow --backend=webgl"
  },
  "dependencies": {
    "@deck.gl-community/gpu-layers": "10.0.0-alpha.7",
    "@deck.gl/core": "patch:@deck.gl/core@npm%3A9.4.0#~/.yarn/patches/@deck.gl-core-npm-9.4.0-707f3fb147.patch",
    "@luma.gl/core": "10.0.0-alpha.7",
    "@luma.gl/engine": "10.0.0-alpha.7",
    "@luma.gl/shaders": "10.0.0-alpha.7",
    "@math.gl/core": "~5.0.0-beta.2",
    "@math.gl/earth": "5.0.0-beta.2"
  },
  "devDependencies": {
    "playwright": "^1.58.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0"
  }
}
