{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@luma.gl/anari": ["../../../modules/anari/src/index.ts"],
      "@luma.gl/anari/gltf": ["../../../modules/anari/src/gltf.ts"],
      "@luma.gl/anari/schemas": ["../../../modules/anari/src/schemas.ts"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["."]
}
