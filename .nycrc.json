{
  "extends": "@istanbuljs/nyc-config-typescript",
  "all": true,
  "sourceMap": false,
  "instrument": true,
  "extensions": [".js", ".ts"],
  "include": ["modules/**/src"],
  "exclude": [
    "**/deprecated",
    "**/bundle.ts",
    "**/*.spec.ts",
    "examples",
    "modules/core/src/webgl-constants",
    "modules/shaders/src/libs",
    "modules/core/src/webgpu",
    "modules/test-utils"
  ]
}
